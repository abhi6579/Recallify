DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Creator/admin account. Use a strong password in production.
ADMIN_NAME=AutoApply Creator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Style Mirror encryption (32 random bytes, base64 encoded)
STYLE_ENCRYPTION_KEY=

# Optional open-weight model providers (Style Mirror works without them)
GROQ_API_KEY=
TOGETHER_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Optional job-market integrations
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional real email delivery
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
